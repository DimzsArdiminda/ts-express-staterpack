generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Change to your database provider
  url      = env("DATABASE_URL")
}

model datauser {
  id        String   @id
  name      String
  email     String   @unique(map: "DataUser_email_key")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime

  data_logs data_log[]
}

model data_log {
  id        String   @id
  userId    String
  action    String
  createdAt DateTime @default(now())
  updatedAt DateTime

  datauser datauser @relation(fields: [userId], references: [id])
}
